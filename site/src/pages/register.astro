---
import AuthForm from '@/components/astro/AuthForm.astro';
import { submitIdentityForm } from '@/lib/user-center';
const locale = Astro.locals.locale;
if (Astro.request.method === 'POST') {
    const form = await Astro.request.formData();
    try {
        const state = await submitIdentityForm(Astro, form, '/api/v1/auth/register', {
            username: String(form.get('username') ?? ''),
            email: String(form.get('email') ?? ''),
            password: String(form.get('password') ?? ''),
            display_name: String(form.get('display_name') ?? '')
        });
        Astro.response.status = 303;
        Astro.response.headers.set('Location', `/register?status=${state}`);
    } catch {
        Astro.response.status = 403;
    }
}
const fields = [
    { name: 'username', label: locale === 'en' ? 'Username' : '用户名', type: 'text' as const, autocomplete: 'username', maxLength: 64 },
    { name: 'email', label: locale === 'en' ? 'Email' : '邮箱', type: 'email' as const, autocomplete: 'email', maxLength: 320 },
    { name: 'display_name', label: locale === 'en' ? 'Display name' : '显示名称', type: 'text' as const, autocomplete: 'name', maxLength: 128 },
    { name: 'password', label: locale === 'en' ? 'Password' : '密码', type: 'password' as const, autocomplete: 'new-password', minLength: 8, maxLength: 128 }
];
---
<AuthForm locale={locale} title={locale === 'en' ? 'Create account' : '注册账户'} description={locale === 'en' ? 'Create a local account, then verify your email before signing in.' : '创建本地账户，并在登录前完成邮箱验证。'} action="/register" fields={fields} status={Astro.response.status === 403 ? 'invalid' : Astro.url.searchParams.get('status')} />
