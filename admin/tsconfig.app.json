{
    "extends": "@vue/tsconfig/tsconfig.json",
    "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue", "src/components.d.ts"],
    "exclude": ["src/assets/**"],
    "compilerOptions": {
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"]
        },
        "lib": ["ESNext", "DOM", "DOM.Iterable"],
        "types": ["vite/client", "node"]
    }
}
