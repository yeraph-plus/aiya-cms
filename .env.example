AIYA_ENV=dev
AIYA_LOG_LEVEL=INFO
AIYA_DATABASE_URL=postgresql+asyncpg://aiya:aiya@postgres:5432/aiya
AIYA_REDIS_URL=redis://redis:6379/0
AIYA_SMTP_HOST=127.0.0.1
AIYA_SMTP_PORT=2525
AIYA_SMTP_USER=
AIYA_SMTP_PASSWORD=
