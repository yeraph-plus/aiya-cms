---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { isLocale, LOCALE_COOKIE, t } from '@/lib/i18n';

const storedLocale = Astro.cookies.get(LOCALE_COOKIE)?.value ?? '';
const locale = isLocale(storedLocale) ? storedLocale : 'zh-CN';
---

<BaseLayout
    locale={locale}
    title={t(locale, 'auth.loggedOut.title')}
    description={t(locale, 'auth.loggedOut.description')}
>
    <section class="detail-page">
        <header class="detail-header">
            <p class="eyebrow">OIDC / Logout</p>
            <h1>{t(locale, 'auth.loggedOut.title')}</h1>
            <p class="lede">{t(locale, 'auth.loggedOut.description')}</p>
        </header>
    </section>
</BaseLayout>
