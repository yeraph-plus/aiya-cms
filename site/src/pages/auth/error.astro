---
import BaseLayout from '@/layouts/BaseLayout.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/i18n';

const locale: Locale = Astro.url.searchParams.get('locale') === 'en' ? 'en' : 'zh-CN';
---

<BaseLayout locale={locale} title={t(locale, 'auth.error.title')} description={t(locale, 'auth.error.description')}>
    <section class="detail-page">
        <header class="detail-header">
            <p class="eyebrow">OIDC / Error</p>
            <h1>{t(locale, 'auth.error.title')}</h1>
            <p class="lede">{t(locale, 'auth.error.description')}</p>
        </header>
    </section>
</BaseLayout>
