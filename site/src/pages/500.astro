---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localeFromPath, t } from '@/lib/i18n';

const locale = localeFromPath(Astro.url.pathname);
Astro.response.status = 500;
---

<BaseLayout
    locale={locale}
    title={t(locale, 'error.unavailable.title')}
    description={t(locale, 'error.unavailable.description')}
>
    <section class="detail-page">
        <header class="detail-header">
            <p class="eyebrow">500</p>
            <h1>{t(locale, 'error.unavailable.title')}</h1>
            <p class="lede">{t(locale, 'error.unavailable.description')}</p>
        </header>
    </section>
</BaseLayout>
