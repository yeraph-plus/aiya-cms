{
  "name": "@aiya/admin",
  "version": "0.0.0",
  "description": "aiya-cms integrated administrator SPA",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=11.11.0"
  },
  "packageManager": "npm@11.11.0",
  "scripts": {
    "build": "vite build --base=/ --mode production",
    "generate:api": "node scripts/generate-api.mjs",
    "check:api": "node scripts/check-openapi.mjs",
    "check:runtime": "node scripts/check-runtime-openapi.mjs",
    "openapi:generate": "npm run generate:api",
    "openapi:check": "npm run check:api",
    "dev": "vite --port 7000 --mode development",
    "dev:mock": "vite --port 7000 --mode mocking",
    "preview": "vite preview --port 7000",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:real": "node scripts/run-real-e2e.mjs",
    "typecheck": "vue-tsc --noEmit",
    "check": "biome check ./src && npm run check:api",
    "check:write": "biome check --write ./src",
    "lint": "biome lint ./src"
  },
  "dependencies": {
    "@vueup/vue-quill": "^1.5.5",
    "@vueuse/core": "^14.4.0",
    "apexcharts": "^6.7.0",
    "moment": "^2.30.1",
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-demi": "^0.14.10",
    "vue-i18n": "^11.4.8",
    "vue-router": "^5.2.0",
    "vue3-apexcharts": "^1.11.1",
    "vue3-map-chart": "^0.4.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@faker-js/faker": "^10.5.0",
    "@intlify/unplugin-vue-i18n": "^11.2.4",
    "@playwright/test": "1.62.1",
    "@unocss/reset": "^66.7.5",
    "@vicons/fluent": "0.13.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vuelidate/core": "^2.0.3",
    "@vuelidate/validators": "^2.0.4",
    "happy-dom": "20.11.1",
    "msw": "^2.15.0",
    "naive-ui": "^2.44.1",
    "openapi-typescript": "7.9.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "sass": "^1.102.0",
    "typescript": "6.0.3",
    "unocss": "^66.7.5",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "8.2.0",
    "vite-plugin-pages": "^0.33.3",
    "vite-plugin-vue-layouts-next": "^2.1.0",
    "vitest": "^4.1.10",
    "vue-tsc": "3.3.9",
    "yaml": "^2.9.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "@parcel/watcher@2.6.0": true,
    "vue-demi@0.13.11": true,
    "vue-demi@0.14.10": true,
    "msw@2.15.0": true
  }
}
