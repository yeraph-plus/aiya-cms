{
    "extends": "astro/tsconfigs/strictest",
    "include": [".astro/types.d.ts", "src/**/*", "tests/**/*", "*.ts", "*.mjs"],
    "exclude": ["dist", "node_modules"],
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/*": ["src/*"]
        },
        "noUncheckedIndexedAccess": true,
        "verbatimModuleSyntax": true,
        "types": ["node", "vitest/globals"]
    }
}
