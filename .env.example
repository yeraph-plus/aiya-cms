AIYA_JWT_REFRESH_TTL_SECONDS=1209600
AIYA_CACHE_BACKEND=redis
AIYA_CORS_ORIGINS=["http://localhost:7000"]
AIYA_PUBLIC_BASE_URL=http://localhost:7000
