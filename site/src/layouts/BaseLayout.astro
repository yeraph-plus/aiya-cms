---
import AppShell from '@/components/astro/AppShell.astro';
import type { Locale } from '@/lib/i18n';
import { t } from '@/lib/i18n';
import { parseTheme, THEME_COOKIE } from '@/lib/theme';
import '@/styles/global.css';

interface Props {
    locale: Locale;
    title: string;
    description: string;
    noindex?: boolean;
}

const { locale, title, description, noindex = true } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url.origin);
const theme = parseTheme(Astro.cookies.get(THEME_COOKIE)?.value);
---

<!doctype html>
<html lang={locale} data-theme={theme}>
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={description} />
        <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
        <link rel="canonical" href={canonical.href} />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
        <meta name="generator" content={Astro.generator} />
        <title>{title} · {t(locale, 'site.name')}</title>
    </head>
    <body>
        <a class="skip-link" href="#main-content">{t(locale, 'nav.skip')}</a>
        <AppShell locale={locale} currentPath={Astro.url.pathname} user={Astro.locals.user} theme={theme}>
            <slot />
        </AppShell>
    </body>
</html>
