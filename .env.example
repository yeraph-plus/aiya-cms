AIYA_ENVIRONMENT=dev
AIYA_APP_PROFILE=release
AIYA_AUTO_INSTALL=true
AIYA_ADMIN_USERNAME=admin
AIYA_ADMIN_EMAIL=admin@example.com
AIYA_ADMIN_PASSWORD=
AIYA_LOG_LEVEL=INFO
AIYA_PG_HOST=host.docker.internal
AIYA_PG_PORT=5432
AIYA_PG_USER=aiya
AIYA_PG_PASSWORD=aiya
AIYA_PG_DATABASE=aiya
# Explicit production/release connection URLs (required by Compose and the
# PostgreSQL/Redis acceptance tests). These override the split fields above.
AIYA_DATABASE_URL=postgresql+asyncpg://aiya:aiya@host.docker.internal:5432/aiya
AIYA_REDIS_HOST=host.docker.internal
AIYA_REDIS_PORT=6379
AIYA_REDIS_DB=0
AIYA_REDIS_PASSWORD=
AIYA_REDIS_URL=redis://host.docker.internal:6379/0
AIYA_JWT_SECRET=replace-this-in-production
AIYA_JWT_ACCESS_TTL_SECONDS=900
AIYA_JWT_REFRESH_TTL_SECONDS=1209600
AIYA_CACHE_BACKEND=redis
AIYA_ISSUER=http://127.0.0.1:8080
AIYA_OIDC_SIGNING_KEY_DIR=/var/lib/aiya/oidc-keys
AIYA_API_AUDIENCE=aiya-admin
AIYA_SECURE_COOKIES=false
AIYA_ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
AIYA_ADMIN_SESSION_IDLE_SECONDS=28800
AIYA_ADMIN_SESSION_ABSOLUTE_SECONDS=1209600
AIYA_CORS_ORIGINS=http://127.0.0.1:8080
AIYA_PUBLIC_BASE_URL=http://127.0.0.1:8080
AIYA_CMS_IMAGE=aiya-cms:production
APP_BIND_ADDRESS=127.0.0.1
APP_HOST_PORT=8080
API_BIND_ADDRESS=127.0.0.1
API_HOST_PORT=8000
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_HOST_PORT=8080
AIYA_SITE_BASE_URL=http://127.0.0.1:4321
AIYA_SITE_OIDC_CLIENT_SECRET=dev-aiya-site-secret-change-before-use-1234567890
SITE_ENVIRONMENT=dev
SITE_ORIGIN=http://127.0.0.1:4321
SITE_API_ORIGIN=http://backend:8000
SITE_OIDC_ISSUER=http://host.docker.internal:8000
SITE_OIDC_CLIENT_ID=aiya-site
SITE_OIDC_SCOPE=openid profile email offline_access
SITE_REDIS_URL=redis://host.docker.internal:6379/1
SITE_HOST_PORT=4321
SITE_BIND_ADDRESS=127.0.0.1
POSTGRES_DB=aiya
POSTGRES_USER=aiya
POSTGRES_PASSWORD=aiya
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
